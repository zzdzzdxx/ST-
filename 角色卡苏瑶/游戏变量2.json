import { registerMvuSchema } from 'https://testingcf.jsdelivr.net/gh/StageDog/tavern_resource/dist/util/mvu_zod.js';

// 定义爱意称号推导逻辑
const getLoveTitle = (lv) => {
  if (lv < 1) return '友善';
  if (lv < 10) return '暗恋';
  if (lv < 20) return '初恋';
  if (lv < 30) return '热恋';
  if (lv < 40) return '眷恋';
  if (lv < 50) return '依恋';
  if (lv < 60) return '深爱';
  if (lv < 70) return '病娇';
  if (lv < 80) return '生死相依';
  if (lv < 90) return '灵魂伴侣';
  if (lv < 100) return '永恒契约';
  if (lv < 110) return '终极归宿';
  return '真爱化身';
};

// 定义生理抗性推导逻辑 (线性递减)
const getResistance = (count) => {
  return Math.max(0, 100 - count);
};

// 定义敏感度级别推导逻辑 (基于生理抗性)
const getSensitivityLevel = (resistance) => {
  if (resistance >= 97) return '青涩';
  if (resistance >= 91) return '觉醒';
  if (resistance >= 85) return '渴求';
  if (resistance >= 80) return '失控';
  if (resistance >= 74) return '享乐';
  if (resistance >= 65) return '纵情';
  if (resistance >= 60) return '畅爽';
  if (resistance >= 50) return '绝巅';
  if (resistance >= 35) return '爽泄';
  if (resistance >= 15) return '登仙';
  if (resistance >= 1) return '纵欲';
  return '欢愉';
};

// 定义部位等级推导逻辑
const getPartLevel = (value) => {
  return Math.floor(value / 100);
};

// 角色通用Schema结构
const CharacterSchema = z.object({
  好感与爱意: z.object({
    好感度: z.number().prefault(0),
    好感度转化状态: z.number().prefault(0),
    爱意值: z.number().prefault(0),
    爱意等级: z.number().prefault(0),
    _爱意阶段称号: z.string().prefault('友善')
  }).transform(data => {
    data._爱意阶段称号 = getLoveTitle(data.爱意等级);
    return data;
  }),
  
  敏感度与境界: z.object({
    圆融计数: z.number().prefault(0),
    当前敏感度等级: z.string().prefault('青涩'),
    _已解锁最高敏感度: z.string().prefault('青涩'),
    敏感度进度条: z.number().prefault(0),
    _生理抗性: z.number().prefault(100),
    红鸾境界: z.enum(['锁灵', '玉润', '星衍', '蕴灵', '灵融', '众妙']).prefault('锁灵')
  }).transform(data => {
    data._生理抗性 = getResistance(data.圆融计数);
    data._已解锁最高敏感度 = getSensitivityLevel(data._生理抗性);
    // 如果当前等级未手动设置，则默认跟随最高等级
    if (!data.当前敏感度等级 || data.当前敏感度等级 === '青涩' && data._生理抗性 < 97) {
        data.当前敏感度等级 = data._已解锁最高敏感度;
    }
    return data;
  }),

  多维行为检测: z.object({
    乳星: z.number().prefault(0),
    孕灵状态: z.string().prefault('期待'),
    诞灵次数: z.number().prefault(0),
    共鸣次数: z.number().prefault(0),
    感官过载次数: z.number().prefault(0)
  }),

  部位进化: z.object({
    香舌: z.object({ 数值: z.number().prefault(0), _Lv: z.number().prefault(0), 状态: z.string().prefault('未开发'), 强化部位1: z.string().prefault('无'), 强化部位2: z.string().prefault('无') }),
    奶子: z.object({ 数值: z.number().prefault(0), _Lv: z.number().prefault(0), 状态: z.string().prefault('未开发'), 强化部位1: z.string().prefault('无'), 强化部位2: z.string().prefault('无') }),
    小穴: z.object({ 数值: z.number().prefault(0), _Lv: z.number().prefault(0), 状态: z.string().prefault('未开发'), 强化部位1: z.string().prefault('无'), 强化部位2: z.string().prefault('无') }),
    菊蕊: z.object({ 数值: z.number().prefault(0), _Lv: z.number().prefault(0), 状态: z.string().prefault('未开发'), 强化部位1: z.string().prefault('无'), 强化部位2: z.string().prefault('无') })
  }).transform(data => {
    data.香舌._Lv = getPartLevel(data.香舌.数值);
    data.奶子._Lv = getPartLevel(data.奶子.数值);
    data.小穴._Lv = getPartLevel(data.小穴.数值);
    data.菊蕊._Lv = getPartLevel(data.菊蕊.数值);
    return data;
  }),

  体液状态: z.object({
    津液: z.string().prefault('湿润拉丝'),
    腋下清汗: z.string().prefault('干爽'),
    足汗油膏: z.string().prefault('干爽'),
    醇湿仙元: z.string().prefault('尚未动情'),
    骚香灵泉: z.string().prefault('紧闭'),
    兰露肠液: z.string().prefault('干涩')
  }),

  体味旋律: z.object({
    体香: z.string().prefault('无'),
    体液香: z.string().prefault('无'),
    临时体香: z.string().prefault('无'),
    口感: z.string().prefault('无')
  }),

  装备与心理: z.object({
    上身: z.string().prefault('无'),
    下身: z.string().prefault('无'),
    内衣: z.string().prefault('无'),
    内裤: z.string().prefault('无'),
    美腿: z.string().prefault('裸露'),
    玉足: z.string().prefault('赤足'),
    配饰: z.array(z.string()).prefault(['无','无','无','无','无','无','无','无']),
    性癖档案: z.array(z.string()).prefault(['未觉醒','未觉醒','未觉醒','未觉醒','未觉醒','未觉醒']),
    实时内心: z.string().prefault('很期待接下来发生的事')
  })
});

export const Schema = z.object({
  全局: z.object({
    时间: z.object({
      年: z.number().prefault(0),
      月: z.number().prefault(4),
      日: z.number().prefault(20),
      时: z.number().prefault(9),
      分: z.number().prefault(30),
      星期: z.string().prefault('周三')
    }),
    资源: z.object({
      现金: z.number().prefault(500),
      积分: z.number().prefault(10)
    }),
    地点: z.string().prefault('堡垒顶层居住区')
  }),
  角色: z.object({
    苏瑶: CharacterSchema,
    叶婉秋: CharacterSchema,
    苏双双: CharacterSchema
  })
});
// 境界突破需要用户主动指令与剧情描写，取消Zod静默自动升级，交由AI根据规则更新

$(() => {
  registerMvuSchema(Schema);
});